# Порт HTTP-сервера
PORT=8080

# Supabase: Project Settings → API → Project URL (БЕЗ /rest/v1 в конце!)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Токен бота от @BotFather — нужен для проверки подписи initData
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# Username бота без @ — используется при генерации ссылки
BOT_USERNAME=your_bot

# Имя бакета в Supabase Storage (создаётся миграцией)
STORAGE_BUCKET=memories

# true — разрешить заголовок `Authorization: dev` для локальной разработки вне Telegram
ALLOW_DEV_AUTH=false

# Порт HTTP-сервера
PORT=8080

# Supabase: Project Settings → API → Project URL (БЕЗ /rest/v1 в конце!)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Токен бота от @BotFather — нужен для проверки подписи initData
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# Username бота без @ — используется при генерации ссылки
BOT_USERNAME=your_bot

# Короткое имя Mini App в BotFather (t.me/bot/memories)
MINI_APP_SHORT_NAME=memories

# Публичный URL backend для Telegram webhook (без слэша в конце)
# PUBLIC_WEBHOOK_URL=https://your-backend.onrender.com
# TELEGRAM_WEBHOOK_SECRET=случайная-строка

# Имя бакета в Supabase Storage (создаётся миграцией)
STORAGE_BUCKET=memories

# true — разрешить заголовок `Authorization: dev` для локальной разработки вне Telegram
ALLOW_DEV_AUTH=false

# ЮKassa: идентификатор магазина и секретный ключ из личного кабинета
# YOOKASSA_SHOP_ID=123456
# YOOKASSA_SECRET_KEY=live_or_test_key

# Публичный URL фронтенда — сюда ЮKassa возвращает после оплаты
# PUBLIC_APP_URL=https://temka-frontend.onrender.com
